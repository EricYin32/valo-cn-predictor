<script>
// 重复提交及JS加载异常修复脚本
console.debug("Widget:Logfix 250720 版载入");

if(window.consoleReplace){
  // 不重复替换
}else{
// 替换 console log info warn 实现
var originalLog = console.log;
var originalInfo = console.info;
var originalWarn = console.warn;

console.log = function (...args) {
  var stack = new Error().stack; // 获取调用堆栈
  var callerInfo = stack.split("\n")[2]?.trim() || "Unknown caller"; // 提取调用来源（第 3 行是调用 console.log 的地方）

  // 判断调用来源是否包含指定字符串，黑名单机制，降级为debug输出
  if (callerInfo.includes("extra.bili") || callerInfo.includes("index.js")) {
    console.debug(...args,`LOG (from: ${callerInfo}):`);
  } else {
    console.debug(`LOG (from: ${callerInfo}):`);
    originalLog(...args);
  }
};

console.info = function (...args) {
  var stack = new Error().stack;
  var callerInfo = stack.split("\n")[2]?.trim() || "Unknown caller";

  if (callerInfo.includes("extra.bili") || callerInfo.includes("index.js")) {
    console.debug(`LOG info (from: ${callerInfo}):`);
    console.debug(...args);
  } else {
    console.debug(`LOG info (from: ${callerInfo}):`);
    originalInfo(...args);
  }
};

console.warn = function (...args) {
  var stack = new Error().stack;
  var callerInfo = stack.split("\n")[2]?.trim() || "Unknown caller";

  if (callerInfo.includes("extra.bili") || callerInfo.includes("index.js") || callerInfo.includes("jquery")) {
    console.debug(`LOG warn (from: ${callerInfo}):`, new Error());
    console.debug(...args);
  } else {
    console.debug(`LOG warn (from: ${callerInfo}):`, new Error());
    originalWarn(...args);
  }
};
}
window.consoleReplace = true;

// 修 ext.echo.special 除了 特殊 页面
if(RLCONF.wgNamespaceNumber != -1){(function hackJSEchoSpecial() { // 提前修改 ext.echo.special 模块代码
    var elapsedTime = 0;
    var intervalId = setInterval(function(){try{
      elapsedTime += 50;
      if (elapsedTime >= 2000) {  // 每隔50毫秒检测一次，直到满2000毫秒
        console.debug("ext.echo.special is not available within the timeout.");
        clearInterval(intervalId); // 超时后停止检测
      }
      if (mw && mw.loader && mw.loader.moduleRegistry['ext.echo.special'].script) {
        mw.loader.moduleRegistry['ext.echo.special'].script = new Function("return " + mw.loader.moduleRegistry['ext.echo.special'].script.toString().replace("(function(){'use strict';$(function(){var specialPageContainer,limitNotifications=50,links=mw.config.get('wgNotificationsSpecialPageLinks'),$content=$(\n'#mw-content-text'),echoApi=new mw.echo.api.EchoApi({limit:limitNotifications}),unreadCounter=new mw.echo.dm.UnreadNotificationCounter(echoApi,['message','alert'],limitNotifications),modelManager=new mw.echo.dm.ModelManager(unreadCounter,{type:['message','alert'],itemsPerPage:limitNotifications,readState:mw.config.get('wgEchoReadState'),localCounter:new mw.echo.dm.UnreadNotificationCounter(echoApi,['message','alert'],limitNotifications,{localOnly:!0,source:'local'})}),controller=new mw.echo.Controller(echoApi,modelManager);mw.echo.config.maxPrioritizedActions=mw.config.get('skin')==='minerva'?1:2;specialPageContainer=new mw.echo.ui.NotificationsInboxWidget(controller,modelManager,{limit:limitNotifications,$overlay:mw.echo.ui.$overlay,prefLink:links.preferences});$(document.body).append(mw.echo.ui.$overlay);$content.empty().append(specialPageContainer.$element);});}());","").replace("function($,jQuery,require,module)","($,jQuery,require,module) =>") )();
        clearInterval(intervalId); // 停止检测
      }
    } catch (error) {}}, 50);
})();}


// 修 ext.flowthread 除了 特殊 页面
if(RLCONF.wgNamespaceNumber != -1){(function hackJSExtFlowthread() { // 提前修改 ext.flowthread 模块代码
    var elapsedTime = 0;
    var intervalId = setInterval(function(){try{
      elapsedTime += 50;
      if (elapsedTime >= 2000) {  // 每隔50毫秒检测一次，直到满2000毫秒
        console.debug("ext.flowthread is not available within the timeout.");
        clearInterval(intervalId); // 超时后停止检测
      }
      if (mw && mw.loader && mw.loader.moduleRegistry['ext.flowthread'].script) {
        mw.loader.moduleRegistry['ext.flowthread'].script = new Function("return " + mw.loader.moduleRegistry['ext.flowthread'].script.toString().replace("isManage=true","isManage=config.FlowThreadAdmin").replace("function($,jQuery,require,module)","($,jQuery,require,module) =>") )();
        clearInterval(intervalId); // 停止检测
      }
    } catch (error) {console.log(error)}}, 50);
})();}

